{
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": {
    "source": "functions",
    "codebase": "default",
    "ignore": [
      "node_modules",
      ".git",
      "firebase-debug.log",
      "firebase-debug.*.log",
      "*.local"
    ],
    "predeploy": [
      "bash scripts/build-functions.sh"
    ]
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8080
    },
    "storage": {
      "port": 9199
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true
  },
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "rolekeeper-7ddcc",
          "appId": "1:843252671350:android:d8c434e7296c81ce209057",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "rolekeeper-7ddcc",
          "configurations": {
            "android": "1:843252671350:android:d8c434e7296c81ce209057",
            "ios": "1:843252671350:ios:66e9e8fa1ddbab37209057",
            "macos": "1:843252671350:ios:66e9e8fa1ddbab37209057",
            "web": "1:843252671350:web:89b21384cc6992f9209057"
          }
        }
      }
    }
  },
  "storage": {
    "rules": "storage.rules"
  }
}