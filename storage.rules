rules_version = '2';

// RoleKeeper Firebase Storage Security Rules
// Paths mirror Firestore tenants: games/{instanceId}/events/{eventSlug}/...
// Legacy top-level characters/ and events/ paths are not used — default deny.

service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(ownerId) {
      return isAuthenticated() && request.auth.uid == ownerId;
    }

    function membershipPath(instanceId, eventSlug) {
      return /databases/(default)/documents/games/$(instanceId)/events/$(eventSlug)/members/$(request.auth.uid);
    }

    function isGameMember(instanceId, eventSlug) {
      return isAuthenticated() && firestore.exists(membershipPath(instanceId, eventSlug));
    }

    function gameMemberRole(instanceId, eventSlug) {
      return isGameMember(instanceId, eventSlug)
        ? firestore.get(membershipPath(instanceId, eventSlug)).data.role
        : '';
    }

    function isStaffOrAbove(instanceId, eventSlug) {
      let role = gameMemberRole(instanceId, eventSlug);
      return role == 'owner' || role == 'superAdmin' || role == 'staff';
    }

    function characterPath(instanceId, eventSlug, characterId) {
      return /databases/(default)/documents/games/$(instanceId)/events/$(eventSlug)/characters/$(characterId);
    }

    function isCharacterOwner(instanceId, eventSlug, characterId) {
      return isAuthenticated()
        && firestore.exists(characterPath(instanceId, eventSlug, characterId))
        && firestore.get(characterPath(instanceId, eventSlug, characterId)).data.ownerId
            == request.auth.uid;
    }

    // User avatars: users/{userId}/avatar.jpg
    match /users/{userId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // Character portraits under tenant path
    match /games/{instanceId}/events/{eventSlug}/characters/{characterId}/{allPaths=**} {
      allow read: if isAuthenticated() && isGameMember(instanceId, eventSlug);
      allow write: if isCharacterOwner(instanceId, eventSlug, characterId);
    }

    // Event media under tenant path (staff/owner only)
    match /games/{instanceId}/events/{eventSlug}/media/{allPaths=**} {
      allow read: if isAuthenticated() && isGameMember(instanceId, eventSlug);
      allow write: if isStaffOrAbove(instanceId, eventSlug);
    }
  }
}
