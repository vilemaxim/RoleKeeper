rules_version = '2';

// RoleKeeper Firebase Storage Security Rules
// Profile images, event media, exportable files

service firebase.storage {
  match /b/{bucket}/o {

    // User avatars: users/{userId}/avatar.jpg
    match /users/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Character portraits: characters/{characterId}/portrait.jpg
    match /characters/{characterId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
      // TODO: Restrict write to character owner (requires Firestore lookup)
    }

    // Event media: events/{eventId}/{allPaths=**}
    match /events/{eventId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
      // TODO: Restrict to event organizer
    }
  }
}
