{
  "mcpServers": {
    "rolekeeper-tdd": {
      "command": "npx",
      "args": ["tsx", "tdd-mcp/src/index.ts"],
      "cwd": "${workspaceFolder}",
      "env": {
        "WORKSPACE_PATH": "${workspaceFolder}"
      }
    },
    "firebase": {
      "command": "npx",
      "args": ["-y", "firebase-tools@latest", "experimental:mcp", "--only", "firestore,auth,storage,functions"]
    }
  }
}
